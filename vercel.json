{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/admin",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/admin.html",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "/feed",
      "dest": "/frontend/feed.html"
    },
    {
      "src": "/profile",
      "dest": "/frontend/profile.html"
    },
    {
      "src": "/notes",
      "dest": "/frontend/notes.html"
    },
    {
      "src": "/tasks",
      "dest": "/frontend/tasks.html"
    },
    {
      "src": "/attendance",
      "dest": "/frontend/attendance.html"
    },
    {
      "src": "/timetable",
      "dest": "/frontend/timetable.html"
    },
    {
      "src": "/resources",
      "dest": "/frontend/resources.html"
    },
    {
      "src": "/auth",
      "dest": "/frontend/auth.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
